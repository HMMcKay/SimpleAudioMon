<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>SimpleAudioMon</RootNamespace>
    <AssemblyName>SimpleAudioMon</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Allows building the Windows app from non-Windows dev machines / CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF0001: the .NET 9 Fluent ThemeMode API is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
