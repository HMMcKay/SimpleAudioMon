<Window x:Class="SimpleAudioMon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SimpleAudioMon.ViewModels"
        Title="Simple Audio Monitor"
        Width="720" Height="860"
        MinWidth="480" MinHeight="360">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Subtle "card" surfaces matching the Windows 11 dark layer style. -->
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#19FFFFFF" />
        <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#2960CDFF" />

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,4,0,8" />
        </Style>

        <Style x:Key="EmptyHintStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="2,0,0,12" />
        </Style>

        <!-- One channel: name, meter, dB readout. -->
        <DataTemplate x:Key="ChannelRowTemplate" DataType="{x:Type vm:ChannelLevelViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Opacity="0.85"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1"
                             Minimum="0" Maximum="100"
                             Value="{Binding LevelPercent, Mode=OneWay}"
                             VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="{Binding LevelDbText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="12"
                           Opacity="0.75" />
            </Grid>
        </DataTemplate>

        <!-- One device: header with name/default badge/master peak, then channel meters. -->
        <DataTemplate x:Key="DeviceCardTemplate" DataType="{x:Type vm:AudioDeviceViewModel}">
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10,14,12"
                    Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,96,0">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Background="{StaticResource BadgeBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Default" FontSize="11" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding MasterText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12"
                                   Opacity="0.6" />
                    </Grid>
                    <TextBlock Text="{Binding Description}"
                               FontSize="12"
                               Opacity="0.55"
                               Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Channels}"
                                  ItemTemplate="{StaticResource ChannelRowTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Single "Levels" tab today; spectrum and spectrogram views slot in as new tabs. -->
        <TabControl Margin="8,8,8,0" Padding="4">
            <TabItem Header="Levels">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4">
                    <StackPanel>
                        <TextBlock Text="Output devices" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="No active output devices."
                                   Style="{StaticResource EmptyHintStyle}"
                                   Visibility="{Binding HasNoOutputs, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding OutputDevices}"
                                      ItemTemplate="{StaticResource DeviceCardTemplate}" />

                        <TextBlock Text="Input devices" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock Text="No active input devices."
                                   Style="{StaticResource EmptyHintStyle}"
                                   Visibility="{Binding HasNoInputs, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding InputDevices}"
                                      ItemTemplate="{StaticResource DeviceCardTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="1" Margin="0,4,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.8" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
